{
  "name": "dsh-shutdown-guard",
  "version": "1.6.2",
  "description": "任务结束后自动关机 —— 侧边栏守夜卡片：五道判定闸、后台任务守卫、AFK 接管、阻断态分级",
  "author": {
    "name": "ltayshark0637",
    "url": "https://github.com/ltayshark0637"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltayshark0637/dsh-Shutdown-Guard.git"
  },
  "homepage": "https://github.com/ltayshark0637/dsh-Shutdown-Guard#readme",
  "bugs": {
    "url": "https://github.com/ltayshark0637/dsh-Shutdown-Guard/issues"
  },
  "main": "lib/index.mjs",
  "icon": "assets/icon-glyph-128.png",
  "files": [
    "lib",
    "assets/icon-shield-2-128.png",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.cjs",
    "gallery": "node scripts/gen-gallery.cjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shutdown",
    "auto-shutdown",
    "guard",
    "idle",
    "automation",
    "windows"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
