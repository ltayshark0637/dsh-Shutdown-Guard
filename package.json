{
  "name": "dsh-shutdown-panel",
  "version": "1.2.0",
  "description": "所有任务结束后自动关机：侧边栏卡片（三种外观 / 可折叠）+ 后台任务守卫",
  "main": "lib/index.mjs",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "license": "MIT"
}
